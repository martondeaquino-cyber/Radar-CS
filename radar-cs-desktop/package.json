{
  "name": "radar-cs",
  "version": "0.2.0",
  "description": "Radar CS - gestão de Customer Success da Lumos",
  "author": "Ana Flavia",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.lumos.radarcs",
    "productName": "Radar CS",
    "files": [
      "main.js",
      "updater.js",
      "app/**",
      "build/tray.png"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "martondeaquino-cyber",
        "repo": "Radar-CS"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}